<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Starfront TargetScheduler Collab</AssemblyName>
    <RootNamespace>StarfrontCollab.Plugin</RootNamespace>
    <Version>0.1.0.0</Version>
    <Title>Starfront TargetScheduler Collab</Title>
    <Description>Reports where the telescope points to a Starfront collaboration server, and keeps Target Scheduler in step with its assignments.</Description>
    <Company>Yann Ramin (@theatrus)</Company>
    <Product>Starfront TargetScheduler Collab</Product>
    <Copyright>Copyright 2026 Yann Ramin</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001" PrivateAssets="all" />
    <ProjectReference Include="../StarfrontCollab.Core/StarfrontCollab.Core.csproj" />
  </ItemGroup>
</Project>
